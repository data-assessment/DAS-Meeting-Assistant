# Runtime configuration only. Never include this file or real keys in an installer.
# Source development: copy to .env. Packaged Community: use Settings or its user .env.

POLL_INTERVAL_SECONDS=5

# Safety net: force-finalize a recording after this many minutes. Teams presence can
# get stuck "in a meeting" (it's calendar-derived) or never drop between back-to-back
# meetings, which would otherwise record forever and never save a transcript. The UI
# Start/Stop buttons are the primary manual control; this is the backstop. 0 disables.
MAX_RECORDING_MINUTES=240

# Azure App Registration (delegated Presence.Read) — required to poll the real
# Microsoft Graph presence of the signed-in user.
GRAPH_TENANT_ID=common
GRAPH_CLIENT_ID=

# Auth flow: device_code (default) or interactive.
# Use "interactive" if device-code sign-in is blocked by a Conditional Access
# policy (error 53003). Requires an http://localhost redirect URI on the app
# registration ("Mobile and desktop applications" platform).
GRAPH_AUTH_MODE=device_code

# AI access mode. "local" keeps the existing endpoint/key behavior. "gateway"
# uses Microsoft sign-in and an APIM endpoint; see docs/deployment-models.md.
AI_MODE=local
# Gateway-only settings (leave blank in local mode):
AI_GATEWAY_ENDPOINT=
AI_GATEWAY_SCOPE=
AI_CLIENT_ID=                       # blank = GRAPH_CLIENT_ID
AI_TENANT_ID=                       # use organizations for customer tenants

# After a meeting, look up its Teams attendance report and write the participant
# list into the transcript. Adds the Calendars.Read, OnlineMeetings.Read and
# OnlineMeetingArtifact.Read.All scopes (all user-consentable). Only covers
# meetings YOU organized.
FETCH_ATTENDEES=true

# Prefer the Teams meeting transcript (named speakers + correct language) when it
# exists — organized meetings with transcription on. Adds OnlineMeetingTranscript.Read.All
# (admin consent). Falls back to batch speech-to-text otherwise.
USE_TEAMS_TRANSCRIPT=true
# The report is generated at/after meeting end with a short lag — retry budget:
ATTENDEE_RETRIES=3
ATTENDEE_RETRY_DELAY_SECONDS=10

# Audio capture (records the meeting to a 16 kHz mono WAV).
# Captures default mic + default speaker loopback.
RECORD_AUDIO=true
# AUDIO_DIR=  # default: profile-specific user directory
AUDIO_SAMPLE_RATE=16000
# Peak-normalize the mix (quiet capture is a top cause of poor transcription).
AUDIO_NORMALIZE=true
AUDIO_TARGET_PEAK_DBFS=-1
AUDIO_MAX_GAIN=30
# Prompt only: if mic and loopback are quiet for this many seconds while Graph
# still thinks a meeting is active, ask whether to stop. 0 disables.
AUDIO_SILENCE_PROMPT_SECONDS=120
AUDIO_ACTIVITY_DBFS=-45

# ── Azure OpenAI CONNECTIONS ────────────────────────────────────────────────
# Two connections (endpoint + key + api-version): a primary and an optional
# failover. They are pure plumbing — models are listed per capability below and
# each is tried on the primary connection first, then the failover automatically.
# AOAI_API_KEY is the resource key (same one used for text generation).
# STT_BACKEND selects the app's speech-to-text provider implementation, not a
# model/deployment name. Current values: azure_openai or none.
STT_BACKEND=azure_openai            # set "none" to skip transcription
AOAI_ENDPOINT=
AOAI_API_KEY=
AOAI_API_VERSION=2024-10-21
# Optional failover connection (tried automatically if the primary can't serve a model).
AOAI_ENDPOINT_2=
AOAI_API_KEY_2=
AOAI_API_VERSION_2=                 # blank = reuse AOAI_API_VERSION

# ── MODELS — one ordered list per capability ────────────────────────────────
# First entry = default/active model; the rest are fallbacks. List plain
# deployment names only; the connection (primary vs failover) is chosen for you.

# Batch transcription models.
#   gpt-4o-transcribe = reliable auto/mixed-language (no speaker labels).
#   gpt-4o-transcribe-diarize = speaker labels, but weaker at multilingual.
TRANSCRIBE_MODELS=gpt-4o-transcribe,gpt-4o-transcribe-diarize
STT_LANGUAGE=                       # force a language (e.g. de) or blank = auto
# Exact names/jargon, comma-separated. Editable per user in Settings. Compatible
# batch/live models receive these hints; gpt-4o-transcribe-diarize cannot accept them.
STT_DICTIONARY=

# Live (realtime) models — primary connection only (realtime API has no failover).
#   gpt-realtime-translate emits the live transcript already translated.
LIVE_MODELS=gpt-4o-transcribe,gpt-realtime-whisper,gpt-realtime-translate

# Chat model(s) for summary / cleanup / translate.
SUMMARY_MODELS=gpt-4o

# ── Behaviour ───────────────────────────────────────────────────────────────
# Transcription mode: batch (after the meeting, diarized) or realtime (live popup
# transcript + diarized final at end). The popup's Live toggle controls this too.
STT_MODE=batch
STT_REALTIME_API_VERSION=2025-04-01-preview
STT_REALTIME_SAMPLE_RATE=24000
# Optional fallback target language for gpt-realtime-translate when the popup
# Translate dropdown is Off. Blank keeps translation off by default.
STT_REALTIME_TRANSLATE_TO=
# gpt-realtime-whisper accuracy/latency trade-off: minimal|low|medium|high|xhigh (blank = default).
STT_REALTIME_WHISPER_DELAY=

# Summary: condense the transcript with the chat model. SUMMARY_LANGUAGE = output language.
SUMMARIZE=true
SUMMARY_LANGUAGE=de

# Clean a plain (no-speaker) batch transcript before saving: replace hallucinated
# gibberish with <unintelligible> and best-effort attribute speakers from context.
CLEAN_TRANSCRIPT=true

# TRANSCRIPT_DIR=  # default: profile-specific user directory
PORT=8765

# OneNote: optional destination from the popup (the local .md is still written).
# ONENOTE_ENABLED=false hides the OneNote button and settings group entirely. Uses
# the SAME Microsoft sign-in as Graph and requests the delegated Notes.ReadWrite
# scope when you save to OneNote. Target notebook + section are found-or-created by
# name on first use.
ONENOTE_ENABLED=false
ONENOTE_NOTEBOOK=Voice Transcriber
ONENOTE_SECTION=Transcripts
# Optional: SharePoint site URLs to include in the notebook picker. This adds the
# Sites.Read.All Graph scope when used because Graph must resolve/search site IDs.
# Use exact site URLs or a tenant base URL to search accessible sites under that host.
ONENOTE_SITE_PATHS=
